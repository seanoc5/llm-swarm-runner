# llm-swarm-runner shipped defaults (safe-for-strangers values).
#
# Override per-project: copy into <project>/.swarm/.env (gitignored).
# Override per-invocation: set as shell env vars.
#
# Precedence (highest wins): shell env > <project>/.swarm/.env > this file.
#
# Loaded by llm-start.sh, coordinator-watch.sh, and provision-worker.sh via
# scripts/_load-env.sh, so all three converge on the same values.

# --- Coordinator behavior ---------------------------------------------------

# Backend selection is normally set per invocation:
#   COORDINATOR_CMD=claude|gemini|codex
#   WORKER_CMD=claude|gemini|codex
# Codex coordination is deliberately one-shot (`codex exec`). Codex workers
# can be interactive, but WORKER_HEADLESS=1 is the better default for
# unattended queue processing.
#
# Claude coordinator runs as an interactive REPL by default (since 2026-05-13)
# so follow-up `llm "..."` invocations land as new messages in the same
# conversation. Set COORDINATOR_HEADLESS=1 to revert to claude -p (exits
# after each prompt, no conversation continuity) for cron, automation, and
# environments where no human is attached to answer the trust dialog.
COORDINATOR_HEADLESS=0

# --- Models -----------------------------------------------------------------

# Coordinator model. Default lives in llm-start.sh and depends on
# COORDINATOR_CMD: claude → claude-fable-5 (Fable 5; 1M context is the
# model's default), gemini → gemini-2.5-flash, codex → CLI default.
# Override per-invocation or here:
#COORDINATOR_MODEL=claude-fable-5

# Worker model. When unset, claude workers default to claude-sonnet-5
# (set in worker-listener.sh — near-Opus coding quality at ~half the cost
# of claude-opus-4-8, which matters with MAX_WORKERS sessions in parallel);
# gemini/codex workers use their CLI's own default. Set this to escalate
# all workers, or pass WORKER_MODEL=<id> per-invocation for one hard issue.
#WORKER_MODEL=claude-opus-4-8

# --- Worker provisioning ----------------------------------------------------

# Max concurrent worker tmux windows. Increase consciously — each worker
# is a Claude Code session and uses real RAM/VRAM/API quota.
MAX_WORKERS=5

# Hard cap on total tmux windows in the session (workers + system windows
# like coordinator/watch/status + leftover finished worker windows the user
# hasn't closed). provision-worker.sh refuses past this.
MAX_TMUX_WINDOWS=10

# Backlog target: housekeeping creates new issues if AVAILABLE issue count
# drops below this. AVAILABLE = open AND (assignee=@me OR no assignee) AND
# not blocked/deferred/awaiting-review AND not owner-labeled (other humans).
TARGET_AVAILABLE=10

# --- Issue filtering --------------------------------------------------------

# Comma-separated label names treated as "owned by a human" (in addition
# to gh assignees). Use on projects with a labels-as-owners convention.
# The coordinator skips issues bearing any owner-label that is NOT @me's
# GitHub login. Example: OWNER_LABELS=sean,radesh
OWNER_LABELS=

# Set to 1 to include issues assigned to others (overrides the @me-or-unassigned
# filter for sustained sprints where you're claiming teammates' work).
# Free-text override in the prompt ("grab anything", "regardless of assignee")
# also works for one-shot use without setting this.
INCLUDE_ASSIGNED_TO_OTHERS=0

# --- Worktree reaping -------------------------------------------------------

# Default age floor for reap-orphan-worktrees.sh — worktrees younger than this
# many days are skipped to give freshly-dispatched workers a buffer. 0 disables
# the floor entirely. Override per-invocation with --min-age-days N.
REAP_MIN_AGE_DAYS=2

# --- Worktree layout --------------------------------------------------------

# Where worker worktrees are created and scanned for. Two layouts:
#
#   flat     — <project-parent>/wt-issue-N
#              Original layout (since v0). Simple, but causes cross-project
#              namespace collisions on hosts running multiple swarms under
#              one parent dir: e.g., fand-guide and fand-etl both try to use
#              /opt/work/oconeco/wt-issue-156/ for their respective #156
#              issues. The losing swarm sees an "orphan" worktree and the
#              winning one has its work clobbered.
#
#   project  — <project-parent>/<project>-worktrees/wt-issue-N
#              Per-project subfolder. Eliminates the collision surface.
#              Recommended for multi-swarm hosts. Adds one path component
#              to the relative reference (e.g., ../fand-guide-worktrees/wt-issue-N
#              instead of ../wt-issue-N).
#
# Default is `flat` for backward compat. Existing worktrees in the flat
# layout are NOT auto-migrated when you flip this to `project` — new
# worktrees go to the new path; old ones stay where they are until you
# reap or manually `git worktree move` them.
SWARM_WORKTREE_GROUPING=flat

# --- Watcher ----------------------------------------------------------------

# Seconds to coalesce repeated coordinator-wake events. Prevents thrash
# when many workers finish near-simultaneously.
DEBOUNCE_SECS=30

# Polling interval for the watcher's poll-mode fallback (used only when
# inotify-tools is not installed).
POLL_SECS=2

# --- Worker communication ---------------------------------------------------

# Default verbosity for spawned workers. Levels (see prompts/worker.md
# for what each one means):
#   verbose  full status updates, options at decisions, NBA hints, teaching
#   normal   milestone updates, options only on real ambiguity
#   concise  outcome-only updates, minimal narrative
#   spartan  single-line status, one-sentence summary
# The summary, decision-framing, NBA hint, and PR risk-rating conventions
# are NEVER suppressed — verbosity controls per-step chatter only.
# Override per-project in <project>/.swarm/.env, or per-invocation via
#   provision-worker.sh -v <level> <issue-N>
WORKER_VERBOSITY=verbose

# Adversarial self-review on 🟡 medium / 🔴 high PRs (see prompts/skill-self-review.md).
# When 1 (default), workers shell out to `claude -p` against the skill prompt
# before proposing merge on 🟡 PRs and before refusing on 🔴 PRs. The fresh
# claude session has no shared context with the task — an actually-skeptical
# read of the diff. Verdict (APPROVE / APPROVE_WITH_CAVEATS / BLOCK) is
# surfaced in the worker's handoff.
#
# Set to 0 to disable (kill switch for cost control, network outages, or
# while iterating on the skill prompt). When disabled, the worker MUST
# flag "self-review: skipped" in its handoff so the operator knows the
# safety layer didn't fire.
#
# 🟢 low PRs never run self-review regardless of this value — low is
# the fast-path tier; doubling per-PR token cost defeats its purpose.
WORKER_SELF_REVIEW=1

# Coordinator-side auto-merge for 🟢 low-risk PRs (see prompts/coordinator.md
# § "Auto-merge low-risk PRs"). When 1, the coordinator MAY run
# `gh pr merge <N> --squash --delete-branch --auto` on a worker's PR without
# waiting for a human `yes`/`go`/`ship`, but only after ALL of: the PR body
# carries the exact `<!-- BLIND_MERGE_RISK: low -->` marker, CI is fully
# green, there's no CHANGES_REQUESTED review, the PR targets the default
# branch, the PR is OPEN and not a draft, and the coordinator's own
# `gh pr diff` read agrees the rating matches the diff's actual scope. Any
# single failure falls back to the default behavior below (render + hand
# back to the human). 🟡/🔴 PRs are never auto-merged regardless of this
# setting, and workers themselves remain forbidden from self-merging
# (examples/swarm-policy.md.example) — this only changes what the
# coordinator may do on the worker's behalf.
#
# Default is 0 (off): auto-merge is hard to walk back (branch deleted,
# squash commit in history), so it's opt-in per project/session. A
# project can also force this off regardless of the env var via
# .swarm-policy.md.
SWARM_AUTOMERGE_LOW=0

# --- Executed acceptance checks ---------------------------------------------
#
# Concept adopted from Nate B. Jones's ringer (see docs/ringer-adoptions.md):
# a task only truly passes when an executed check exits 0 — not when the
# agent declares done. After the agent exits, worker-listener.sh resolves a
# check command (brief `<!-- SWARM_CHECK: <cmd> -->` marker → worktree
# .swarm/check.sh → WORKER_CHECK_CMD below), runs it, and stamps
# check_cmd/check_exit/check_output_tail into done/<id>.json. A failing
# check flips the outcome to err even when the agent exited 0.
#
# WORKER_CHECK=0 is the kill switch (reverts to agent-exit-only outcomes).
WORKER_CHECK=1
# Listener-wide default check when neither the brief nor the worktree
# provides one — e.g. the project's test suite. Unset = no default check.
#WORKER_CHECK_CMD=./gradlew test
# Seconds before a hung check is killed (timeout exit 124 = failure).
WORKER_CHECK_TIMEOUT=600
# Retry-once on check failure (also a ringer concept): re-dispatch the agent
# a single time with the check's failure output injected into the prompt,
# then re-run the check. Doubles the task's token cost when it fires — set
# to 0 to disable and surface check failures immediately instead.
WORKER_CHECK_RETRY=1

# --- Eval log (ringer-style; docs/ringer-adoptions.md #3) --------------------
#
# worker-listener.sh appends one JSONL row per completed v2 task (agent,
# model, duration, exit code, check result, retried, outcome). Aggregate
# with scripts/swarm-scoreboard.sh for per-(agent, model) pass rates.
# Default is per-worktree .swarm/eval-log.jsonl; set an absolute path
# OUTSIDE the worktrees to survive worktree reaping and pool all workers
# into one log.
#SWARM_EVAL_LOG=/opt/work/myproject/.swarm/eval-log.jsonl

# Brief lint on provisioning (ringer concept; docs/ringer-adoptions.md #6).
# provision-worker.sh warns when a queued brief has no acceptance criteria /
# SWARM_CHECK marker, a can't-fail check, no named files, or is
# underspecified. Warn-only — dispatch always proceeds. 0 disables.
BRIEF_LINT=1

# --- Host bind-mounts (optional) -------------------------------------------
#
# Comma-separated `host:container:ro|rw` specs, parsed by sandbox.sh:97-143
# and passed to docker as -v flags. `host:ro` (no container path) means
# the host path is mounted at the same path inside the container.
#
# `${FAND_DATA_ROOT}` is the one shell-style sentinel scripts/_load-env.sh
# expands here, AFTER FAND_DATA_ROOT itself is resolved (caller env >
# project .swarm/.env > this file). Lets a project set FAND_DATA_ROOT
# once in <project>/.swarm/.env and have both the loader-side data path
# AND the swarm-side bind mount follow. See fand-poc ADR-0008.
#
# Example (uncomment + customize per project):
#EXTRA_MOUNTS=${FAND_DATA_ROOT}:ro,/opt/work/oconeco/fand-app:ro
