.tools/
*.bak

# Editor / IDE local config
.vscode/
.idea/
*.swp
*~

# Swarm runtime state (events log, optional .env, task queues).
# coordinator.md describes everything here as runtime artifacts.
.swarm/

# Repo-root .env for personal-machine overrides (MAX_WORKERS, FAND_DATA_ROOT, etc.).
# Shipped defaults live in .env.example (tracked); per-project durable overrides
# go in <project>/.swarm/.env (gitignored above). Root-only — anchored with the
# leading slash so it does NOT shadow .env files inside subdirs that might
# legitimately be tracked.
/.env

# Repo-root local swarm policy. examples/swarm-policy.md.example is the
# tracked template; per-project opt-ins (e.g. at-rest glyph) belong in a
# local .swarm-policy.md that should NOT be committed.
/.swarm-policy.md

# Demo recording artifacts produced by scripts/demo-record-setup.sh,
# scripts/edit-demo.sh, and asciinema — see docs/demo-recording.md.
# Default output lands in ~/Videos/, but guard against stray copies into the repo.
*.mp4
*.mkv
*.gif
*.cast
demo-*.png

# Editor / OS junk
.DS_Store
Thumbs.db
